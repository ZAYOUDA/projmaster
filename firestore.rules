rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function getRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAdmin() {
      return request.auth != null && getRole() == "admin";
    }
    function isManager() {
      return request.auth != null && getRole() == "manager";
    }
    function isChefProjet() {
      return request.auth != null && getRole() == "chef_projet";
    }
    function isCollab() {
      return request.auth != null && getRole() == "collaborateur";
    }
    // Client = profil externe en lecture seule, scopé à (généralement) 1 seul projet via
    // projets_autorises. Toujours un rôle GLOBAL (pas de surcharge par projet comme
    // chef_projet/collaborateur) : un compte client n'est jamais aussi collaborateur/chef de
    // projet ailleurs.
    function isClient() {
      return request.auth != null && getRole() == "client";
    }
    // Rôle EFFECTIF d'une personne sur un projet précis : surcharge dans
    // users/{uid}.projets_roles[projetId] si présente, sinon le rôle global (getRole()).
    // Permet à un même profil d'être collaborateur sur un projet et chef de projet sur un
    // autre. Absence de projets_roles ou d'entrée pour ce projet = comportement inchangé
    // (rétrocompatible, aucune migration de données requise).
    function getRoleSurProjet(projetId) {
      let u = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return u.get('projets_roles', {}).get(projetId, u.role);
    }
    function isChefProjetSur(projetId) {
      return request.auth != null && getRoleSurProjet(projetId) == "chef_projet";
    }
    // Utilisé pour les droits "collaborateur" sur /projets : indispensable pour le cas de
    // rétrogradation (rôle global chef_projet, mais surchargé en collaborateur sur CE projet)
    // — sans ça, isCollab() global renverrait false et la personne perdrait tout accès au lieu
    // de retomber sur les droits collaborateur.
    function isCollabSur(projetId) {
      return request.auth != null && getRoleSurProjet(projetId) == "collaborateur";
    }
    // Admin + Manager : accès total, indépendant de projets_autorises.
    function hasFullAccess() {
      return isAdmin() || isManager();
    }
    // Lecture (au minimum) sur ce projet précis.
    function canAccessProjet(projetId) {
      return hasFullAccess() ||
        get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.projets_autorises.hasAny([projetId]);
    }
    // Écriture complète sur ce projet précis (Chef de Projet — au sens du rôle PAR PROJET,
    // pas du rôle global : cf. getRoleSurProjet ci-dessus).
    function canManageProjet(projetId) {
      return hasFullAccess() || (isChefProjetSur(projetId) && canAccessProjet(projetId));
    }

    match /users/{userId} {
      allow read: if request.auth.uid == userId || hasFullAccess();

      allow create: if isAdmin() || (isManager() && request.resource.data.role != "admin");

      // Un utilisateur peut toujours mettre à jour sa propre derniere_connexion, et lever/poser
      // lui-même doit_changer_mdp (écran de changement de mot de passe à la première connexion
      // / après une réinitialisation admin — cf. terminerPremiereConnexion dans firebase/auth.js).
      // Chef de Projet peut mettre à jour son propre projets_autorises (auto-ajout lors de la
      // création d'un projet — cf. addProjet dans useAppStore.js) et rien d'autre sur son doc.
      // Admin gère tout le monde. Manager gère tout sauf les comptes Admin (ni cible, ni état actuel).
      allow update: if (request.auth.uid == userId
                         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['derniere_connexion', 'doit_changer_mdp']))
                    || (request.auth.uid == userId && isChefProjet()
                         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['projets_autorises']))
                    || isAdmin()
                    || (isManager() && resource.data.role != "admin" && request.resource.data.role != "admin");

      allow delete: if isAdmin() || (isManager() && resource.data.role != "admin");
    }

    match /collaborateurs/{collabId} {
      // isClient() : Résumé/Planning/Kanban affichent les noms/initiales des collaborateurs
      // assignés — sans cette lecture, ces onglets montreraient des profils vides pour un Client.
      allow read: if hasFullAccess() || isChefProjet() || isCollab() || isClient();
      allow write: if hasFullAccess();
    }

    match /projets/{projetId} {
      // Admin/Manager : accès total, y compris suppression.
      allow read, write: if hasFullAccess();
      // Chef de Projet : lecture + modification sur ses projets, mais jamais de suppression.
      allow read, update: if canManageProjet(projetId);
      // Chef de Projet : peut créer un nouveau projet (s'auto-ajoute ensuite à son
      // projets_autorises via la règle /users ci-dessus — voir addProjet dans useAppStore.js).
      allow create: if isChefProjet();
      // Collaborateur : lecture + mise à jour limitée (assignation/avancement) sur ses projets.
      // isCollabSur (rôle PAR PROJET), pas isCollab (rôle global) : sinon quelqu'un dont le
      // rôle global est chef_projet mais rétrogradé en collaborateur sur CE projet précis
      // perdrait tout accès au lieu de retomber sur les droits collaborateur.
      allow read: if isCollabSur(projetId) && canAccessProjet(projetId);
      allow update: if isCollabSur(projetId) && canAccessProjet(projetId);
      // Client : lecture SEULE sur son (ses) projet(s) autorisé(s), jamais d'écriture — cf.
      // useAuth.jsx isClient / ProjetLayout.jsx (Planning, Kanban, RIAD, Résumé uniquement).
      allow read: if isClient() && canAccessProjet(projetId);
    }

    match /app_config/{doc} {
      allow read, write: if hasFullAccess();
    }

    // To-do personnelle (Admin/Manager/Chef de Projet) — strictement la sienne, jamais partagée.
    match /taches/{tacheId} {
      allow read, update, delete: if (hasFullAccess() || isChefProjet())
                                   && resource.data.owner_id == request.auth.uid;
      allow create: if (hasFullAccess() || isChefProjet())
                    && request.resource.data.owner_id == request.auth.uid;
    }
  }
}
